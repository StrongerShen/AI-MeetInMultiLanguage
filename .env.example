# ==============================================================================
# AI Meet In Multi-Language 環境設定範本
# 請複製本檔案為 .env，並依主機環境調整；切勿將真實 API 金鑰提交至版本控制。
# ==============================================================================

# 雲端 OpenAI API 金鑰（若僅使用本機 Breeze ASR 與本機 Ollama，可留空）
OPENAI_API_KEY=

# 應用程式資料與音訊儲存目錄（預設為本機 ./var 目錄）
APP_DATA_DIR=./var

# 單一音訊上傳大小上限（位元組，預設 200 MiB = 209715200）
APP_MAX_UPLOAD_BYTES=209715200

# 本機 Speaches ASR 服務 API 根路徑（預設監聽 127.0.0.1:8001）
SPEACHES_URL=http://127.0.0.1:8001/v1

# 本機 Ollama 服務 API 根路徑（預設監聽 127.0.0.1:11434）
OLLAMA_URL=http://127.0.0.1:11434

# 預設會議結構化摘要模型（建議使用 qwen3.5:9b 兼顧結構完整度與 8 GiB 顯存餘裕）
OLLAMA_MODEL=qwen3.5:9b
